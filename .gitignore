# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# ── Secrets ───────────────────────────────────────────────────────
# `backend/.env` holds live provider keys (Groq, Cerebras, Gemini) plus
# database, Redis, ClickHouse and Langfuse credentials. It must never be
# committed — a pushed key has to be treated as burned and rotated, and
# deleting it in a later commit does not remove it from history.
#
# `frontend/.gitignore` covers only `frontend/.env`; nested ignore files do
# not cascade upward or sideways, so `backend/.env` is protected by the rules
# here and nowhere else.
#
# `.env` alone already matches at every depth. `backend/.env` and `**/.env`
# are kept as explicit belt-and-braces: they cost nothing and make the intent
# unmissable to anyone auditing this file before a first push.
.env
backend/.env
**/.env
.env.*
!.env.example

# ── Tool caches ───────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
